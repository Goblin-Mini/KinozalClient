name = "kinozal-tv-license"
main = "src/index.ts"
compatibility_date = "2026-11-12"

[[d1_databases]]
binding = "DB"
database_name = "kinozal-tv-license"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Configure secrets with:
#   npx wrangler secret put ADMIN_TOKEN
#   npx wrangler secret put PLUS_SIGNING_PRIVATE_KEY
# PLUS_SIGNING_PRIVATE_KEY must be an unencrypted PKCS#8 RSA private-key PEM.
# Never commit either secret or put the signing private key in the Android APK.
# Set ALLOWED_ORIGIN as a plain-text Worker variable to the exact Pages origin.
