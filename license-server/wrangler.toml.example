name = "kinozal-tv-license"
main = "src/index.ts"
compatibility_date = "2026-11-12"

[[d1_databases]]
binding = "DB"
database_name = "kinozal-tv-license"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Configure ADMIN_TOKEN with:
#   npx wrangler secret put ADMIN_TOKEN
# Never commit the real token or put it in the Android APK.
# Optional: set ALLOWED_ORIGIN as a Worker variable if a web admin page is added.
